# ===================== CMake 专属生成产物 =====================
# CMake 构建目录（最常用：build 文件夹，绝大多数人编译都建build）
build/
_build/
cmake-build-*/

# CMake 缓存与配置文件
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt

# 生成的 Makefile / Ninja 构建脚本
Makefile
*.ninja
*.ninja_deps
*.ninja_log

# 临时日志、依赖文件
*.log
*.cmake